# Environment variables for Career Navigator Backend API (FastAPI)

# Postgres connection components (used if DATABASE_URL is not provided)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=career_navigator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full SQLAlchemy URL alternative (overrides POSTGRES_* if set)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/career_navigator

# CORS allowed origins for the backend API (comma-separated)
# For local development with the React app running on 3000:
CORS_ALLOW_ORIGINS=http://localhost:3000
