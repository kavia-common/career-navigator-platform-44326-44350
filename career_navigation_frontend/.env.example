# Frontend environment template for Career Navigator (React - CRA)
# Note: Copy this file to `.env` for local development. Do not commit your real .env.

# Primary service URLs
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_RECOMMENDER_URL=http://localhost:8081

# Optional/common settings (placeholders — adjust per environment)
REACT_APP_API_BASE=http://localhost:8000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_NODE_ENV=development
REACT_APP_PORT=3000
REACT_APP_LOG_LEVEL=info
